# NORA API — environment template
# Copy to api/.env and fill in real values. Never commit api/.env.
#   cp api/.env.example api/.env

# --- Required ---------------------------------------------------------------

# Signs and verifies JWTs and the Rails session cookie. REQUIRED — the app will
# not boot without either this or config/master.key. Generate one with:
#
#   openssl rand -hex 64
#
SECRET_KEY_BASE=

# OpenAI API key, read only by Ai::Client. Chart excerpts sent to the model
# are PHI: do not use a key without a signed BAA and zero data retention.
OPENAI_API_KEY=

# Model used for evidence extraction. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Production refuses to send chart text to the model until this is "true".
# Set it only once a BAA with zero data retention covers the key above.
AI_PHI_BAA_CONFIRMED=

# Production only: "true" seeds the synthetic demo practice and enables
# one-click sign-in at /demo. Development and test always have it. Leave unset
# on a deployment that serves real practices.
DEMO_PRACTICE=

# --- Email (required in production, optional in dev) ------------------------

# Resend API key for transactional email. Without it, mail is logged, not sent.
RESEND_API_KEY=

# Sender address. Defaults to the Resend onboarding address when unset.
RESEND_FROM_EMAIL=

# Base URL of the frontend, used to build links in outgoing email.
# Must point at the Next.js app (port 3005), not the API (port 3006).
FRONTEND_URL=http://localhost:3005

# --- Optional ---------------------------------------------------------------

# Redis, used as the Rails cache store. Defaults to redis://localhost:6379/0 in development.
# Required in production.
REDIS_URL=redis://localhost:6379/0

# Sentry error tracking. Safe to leave blank in development.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- FHIR (optional) ---------------------------------------------------------
# Where Nora reads each patient's structured chart (US Core R4). Unset: the
# demo bundles in db/fhir/demo. A local HAPI server: http://localhost:8090/fhir
# (load it with `bin/rails fhir:load`). A bearer token if the server needs one.
FHIR_BASE_URL=
FHIR_BEARER_TOKEN=
# SMART Backend Services instead of a fixed token: `bin/rails fhir:smart_key`
# makes a key pair and prints the JWK Set to register with the server. Nora
# finds the token endpoint in the server's .well-known/smart-configuration
# unless FHIR_TOKEN_URL names it.
FHIR_CLIENT_ID=
FHIR_PRIVATE_KEY_PATH=
FHIR_TOKEN_URL=
