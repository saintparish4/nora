    {
      "linkId": "bmi",
      "text": "What was the patient's BMI at baseline, before any GLP-1 or GLP-1/GIP drug?",
      "type": "choice",
      "required": true,
      "extension": [
        {
          "url": "https://nora.example/fhir/StructureDefinition/plain-language",
          "valueString": "The plan wants the BMI from before the patient started any weight-loss drug, not today's if they have already taken one. Nora uses the BMI a person verified for this requirement."
        },
        {
          "url": "https://nora.example/fhir/StructureDefinition/answer-rule",
          "extension": [
            {
              "url": "from",
              "valueCode": "criterion_bmi"
            },
            {
              "url": "criterion",
              "valueInteger": 3
            }
          ]
        },
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression",
          "valueExpression": {
            "language": "text/cql-identifier",
            "expression": "NoraCignaWegovy.\"bmi\""
          }
        }
      ],
      "answerOption": [
        {
          "valueCoding": {
            "system": "https://nora.example/fhir/CodeSystem/cigna-wegovy-bmi",
            "code": "under-27",
            "display": "Less than 27 kg/m2"
          }
        },
        {
          "valueCoding": {
            "system": "https://nora.example/fhir/CodeSystem/cigna-wegovy-bmi",
            "code": "27-29.9",
            "display": "Between 27 kg/m2 and 29.9 kg/m2"
          }
        },
        {
          "valueCoding": {
            "system": "https://nora.example/fhir/CodeSystem/cigna-wegovy-bmi",
            "code": "30-plus",
            "display": "Greater than or equal to 30kg/m2"
          }
        }
      ]
    },
    {
      "linkId": "comorbidity",
      "text": "If baseline BMI is 27 to 29.9: does the patient have one of hypertension, type 2 diabetes, dyslipidemia, obstructive sleep apnea, cardiovascular disease, knee osteoarthritis, asthma, COPD, MASLD/NAFLD, polycystic ovarian syndrome, or coronary artery disease?",
