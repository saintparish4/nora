# NORA API — environment template
# Copy to api/.env and fill in real values. Never commit api/.env.
#   cp api/.env.example api/.env

# --- Required ---------------------------------------------------------------

# Signs and verifies JWTs and the Rails session cookie.
# Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=

# OpenAI API key used by Triage::SymptomAnalyzerService (gpt-4o-mini).
# Symptom text is PHI — see docs before pointing this at a production key.
OPENAI_API_KEY=

# --- Email (required in production, optional in dev) ------------------------

# Resend API key for transactional email. Without it, mail is logged, not sent.
RESEND_API_KEY=

# Sender address. Defaults to the Resend onboarding address when unset.
RESEND_FROM_EMAIL=

# Base URL of the frontend, used to build links in outgoing email.
# Must point at the Next.js app (port 3000), not the API (port 3001).
FRONTEND_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------

# Redis, used by Sidekiq. Defaults to redis://localhost:6379/0 in development.
# Required in production.
REDIS_URL=redis://localhost:6379/0

# Sentry error tracking. Safe to leave blank in development.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Google Calendar (not yet wired up) -------------------------------------
# Read by config/initializers/google_calendar.rb. The calendar_connections
# table exists but no OAuth flow is implemented yet, so these are inert today.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/provider/calendar/callback
