# NORA frontend — environment template
# Copy to base/.env.local and fill in real values. Never commit base/.env.local.
#   cp base/.env.local.example base/.env.local

# --- Required ---------------------------------------------------------------

# Base URL of the Rails API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Optional ---------------------------------------------------------------

# Sentry error tracking. Safe to leave blank in development.
# NEXT_PUBLIC_SENTRY_DSN is used by the browser bundle; SENTRY_DSN by the
# server and edge runtimes. Set both to the same value.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Used only to upload source maps during a production build.
SENTRY_AUTH_TOKEN=
