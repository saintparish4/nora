# Root level .gitignore for NORA project

# Rails API specific ignores
/api/coverage
/api/log/*
!/api/log/.keep
/api/tmp/*
!/api/tmp/.keep
!/api/tmp/pids/.keep
!/api/tmp/storage/.keep
/api/storage/*
!/api/storage/.keep
/api/public/assets
/api/config/master.key
/api/config/credentials.yml.enc
/api/storage/development.sqlite3
/api/storage/*.sqlite3
/api/storage/*.sqlite3-*

# Next.js specific ignores
/base/node_modules
/base/.next
/base/out
/base/build
/base/.env*

# General ignores
/notebook
.DS_Store
*.log
*.tmp
*.cache
.env*
*.pem

# IDE files
.vscode/
.idea/
.cursor/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store

# Personal 
book/