      "answerOption": [
        {
          "valueCoding": {
            "system": "https://nora.example/fhir/CodeSystem/cigna-wegovy-comorbidity",
            "code": "yes",
            "display": "Yes"
          }
        },
        {
          "valueCoding": {
            "system": "https://nora.example/fhir/CodeSystem/cigna-wegovy-comorbidity",
            "code": "no",
